{
  "name": "qwbe-core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "qwbe": "./bin/qwbe.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "qwbe.config.json"
  ],
  "_exportsComment": "Two shapes, one manifest. A checkout resolves qwbe-core/* to the TypeScript sources (default) -- node strips types there, and the kernel itself boots from src. An install cannot: node refuses type stripping under node_modules, so `qwbe check` boots the kernel from dist/ and spawns it with --conditions=qwbe-dist, which flips every subpath to the compiled file. Same code, compiled once by `npm run build` (also run by prepack, before npm pack tars the package).",
  "exports": {
    ".": {
      "qwbe-dist": "./dist/cube-contract.js",
      "default": "./src/cube-contract.ts"
    },
    "./package.json": "./package.json",
    "./cube": {
      "qwbe-dist": "./dist/cube-contract.js",
      "default": "./src/cube-contract.ts"
    },
    "./agent": {
      "qwbe-dist": "./dist/agent-contracts.js",
      "default": "./src/agent-contracts.ts"
    },
    "./http": {
      "qwbe-dist": "./dist/http-contracts.js",
      "default": "./src/http-contracts.ts"
    },
    "./auth": {
      "qwbe-dist": "./dist/auth-contracts.js",
      "default": "./src/auth-contracts.ts"
    },
    "./entity": {
      "qwbe-dist": "./dist/entity-contracts.js",
      "default": "./src/entity-contracts.ts"
    },
    "./errors": {
      "qwbe-dist": "./dist/error-contracts.js",
      "default": "./src/error-contracts.ts"
    },
    "./pagination": {
      "qwbe-dist": "./dist/pagination-contracts.js",
      "default": "./src/pagination-contracts.ts"
    },
    "./list": {
      "qwbe-dist": "./dist/list-contracts.js",
      "default": "./src/list-contracts.ts"
    },
    "./permissions": {
      "qwbe-dist": "./dist/permissions-contracts.js",
      "default": "./src/permissions-contracts.ts"
    },
    "./package": {
      "qwbe-dist": "./dist/package-contract.js",
      "default": "./src/package-contract.ts"
    },
    "./custom-values": {
      "qwbe-dist": "./dist/custom-values.js",
      "default": "./src/custom-values.ts"
    }
  },
  "description": "Qwbe — kernel that discovers cubes from disk. Knows no cube by name.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "prepack": "npm run build",
    "boundaries": "depcruise src plugins --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.107.0",
    "effect": "^3.21.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.0.0",
    "typescript": "^5.7.0"
  }
}
