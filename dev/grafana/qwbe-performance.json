      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "qwbe_process_heap_used_bytes_ratio",
          "legendFormat": "heap used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "qwbe_process_heap_after_gc_bytes_ratio",
          "legendFormat": "heap after GC"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "qwbe_process_heap_total_bytes_ratio",
