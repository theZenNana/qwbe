{
  "uid": "qwbe-perf",
  "title": "qwbe performance",
  "tags": [
    "qwbe"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Start the API with QWBE_TRACE_URL=http://localhost:4318. Requests latency panels fill once the qwbe.http.request.duration histogram exists.",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Duration p50 / p99 by cube",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, cube) (rate({__name__=~\"qwbe_http_request_duration.*_bucket\"}[$__rate_interval])))",
          "legendFormat": "p50 {{cube}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, cube) (rate({__name__=~\"qwbe_http_request_duration.*_bucket\"}[$__rate_interval])))",
          "legendFormat": "p99 {{cube}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Built on the histogram qwbe.http.request.duration (labels cube, route, method, status). Empty until the API exports that metric; the name is matched with a regex because the Prometheus unit suffix is not fixed yet. Unit is whatever the histogram records.",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Duration p50 / p99 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, method, route) (rate({__name__=~\"qwbe_http_request_duration.*_bucket\"}[$__rate_interval])))",
          "legendFormat": "p50 {{method}} {{route}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, method, route) (rate({__name__=~\"qwbe_http_request_duration.*_bucket\"}[$__rate_interval])))",
          "legendFormat": "p99 {{method}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Built on the histogram qwbe.http.request.duration (labels cube, route, method, status). Empty until the API exports that metric; the name is matched with a regex because the Prometheus unit suffix is not fixed yet. Unit is whatever the histogram records.",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "table",
      "title": "Slowest requests (click a trace id)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Request spans from Tempo, slowest first. The trace id links to the waterfall.",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"qwbe\" && name =~ \"http.server.*\" } | select(span.qwbe.cube)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Duration",
            "desc": true
          }
        ]
      },
      "id": 4,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Resources per request",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU user per request, p50 by cube",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"qwbe\" && name =~ \"http.server.*\" } | quantile_over_time(span.qwbe.cpu.user_us, 0.5) by (span.qwbe.cube)",
          "metricsQueryType": "range",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "TraceQL metrics over the request span attributes that QWBE_PROFILE=resources adds. Needs Tempo's local-blocks metrics processor; empty when the image has it off.",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      }
    },
    {
      "type": "timeseries",
      "title": "CPU system per request, p50 by cube",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"qwbe\" && name =~ \"http.server.*\" } | quantile_over_time(span.qwbe.cpu.system_us, 0.5) by (span.qwbe.cube)",
          "metricsQueryType": "range",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "TraceQL metrics over the request span attributes that QWBE_PROFILE=resources adds. Needs Tempo's local-blocks metrics processor; empty when the image has it off.",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      }
    },
    {
      "type": "timeseries",
      "title": "Heap delta per request, p50 by cube",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"qwbe\" && name =~ \"http.server.*\" } | quantile_over_time(span.qwbe.heap.delta, 0.5) by (span.qwbe.cube)",
          "metricsQueryType": "range",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "TraceQL metrics over the request span attributes that QWBE_PROFILE=resources adds. Needs Tempo's local-blocks metrics processor; empty when the image has it off.",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Process",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
