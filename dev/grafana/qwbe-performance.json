    {
      "type": "table",
      "title": "Top 20 statements by total time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qwbe-pg"
      },
      "description": "Server-wide since the last SELECT pg_stat_statements_reset();",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qwbe-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT d.datname AS database, s.query, s.calls, round(s.mean_exec_time::numeric, 2) AS mean_ms, round(s.total_exec_time::numeric, 2) AS total_ms, s.rows FROM pg_stat_statements s JOIN pg_database d ON d.oid = s.dbid ORDER BY s.total_exec_time DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "query"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 600
              }
            ]
          }
        ]
      },
      "options": {},
      "id": 17,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 46
      }
    },
    {
      "type": "table",
      "title": "Top 20 statements by mean time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qwbe-pg"
      },
      "description": "Server-wide since the last SELECT pg_stat_statements_reset();",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qwbe-pg"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT d.datname AS database, s.query, s.calls, round(s.mean_exec_time::numeric, 2) AS mean_ms, round(s.total_exec_time::numeric, 2) AS total_ms, s.rows FROM pg_stat_statements s JOIN pg_database d ON d.oid = s.dbid ORDER BY s.mean_exec_time DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
