{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "options": {
        "allows": [
          "/admin@example\\.com/",
          "/reader@example\\.com/",
          "/postgres:\\/\\/postgres:qwbe@localhost:5433\\/qwbe/"
        ]
      },
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": {
            "allows": ["/postgres:\\/\\/postgres:qwbe@localhost:5433\\/qwbe/"]
          }
        }
      ]
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "AWS access key id",
            "pattern": "/\\b(AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\\b/"
          },
          {
            "name": "Anthropic API key",
            "pattern": "/sk-ant-[A-Za-z0-9_-]{20,}/"
          },
          {
            "name": "OpenAI API key",
            "pattern": "/sk-(proj-)?[A-Za-z0-9_-]{32,}/"
          },
          {
            "name": "Slack bot token",
            "pattern": "/xox[baprs]-[A-Za-z0-9-]{10,}/"
          },
          {
            "name": "Private key block",
            "pattern": "/-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----/"
          },
          {
            "name": "Hardcoded password assignment",
            "pattern": "/\\b(password|passwd|secret|api_?key|token)\\s*[:=]\\s*[\"'][^\"'{}$\\s]{6,}[\"']/i",
            "allows": ["/secret: \"(leaked|deleted|kernel-owned|must-not-leak)\"/"]
          },
          {
            "name": "Local home path",
            "pattern": "/\\/home\\/[a-z][a-z0-9_-]*\\//"
          }
        ]
      }
    }
  ]
}
