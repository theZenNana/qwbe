{
  "name": "qwbe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Qwbe — kernel that discovers cubes from disk. One cube = one directory; installing it touches no existing file.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "prepare": "husky",
    "ascii": "node scripts/check-ascii.mjs",
    "branch": "node scripts/check-branch.mjs",
    "secrets": "npx --no-install secretlint \"**/*\"",
    "start": "node scripts/start.mjs",
    "api": "node core/src/main.ts",
    "web": "npm --prefix web run dev",
    "test": "node --test \"core/**/*.test.ts\" \"web/**/*.test.ts\"",
    "format": "biome format --write .",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p core/tsconfig.json",
    "typecheck:web": "node scripts/typecheck-web.mjs",
    "check": "node scripts/check.mjs",
    "check:strict": "node scripts/check.mjs --strict",
    "probe:smoke": "node probes/smoke.mjs",
    "probe:security": "node probes/security.mjs",
    "probe:restart": "node probes/restart.mjs",
    "probe:drift": "node probes/drift.mjs",
    "probe:admin-restart": "node probes/admin-restart.mjs",
    "probe:decoupling": "node probes/decoupling.mjs",
    "probe:install": "node probes/install.mjs",
    "probe:install-from": "node probes/install-from.mjs",
    "probe:sizecaps": "node probes/sizecaps.mjs",
    "probe:testgate": "node probes/testgate.mjs",
    "probe:untracked": "node probes/untracked.mjs",
    "probe:all": "npm run probe:store && npm run probe:smoke && npm run probe:security && npm run probe:restart && npm run probe:drift && npm run probe:admin-restart && npm run probe:decoupling && npm run probe:install && npm run probe:install-from && npm run probe:lifecycle",
    "verify": "npm run check && npm run probe:all",
    "compliance": "node scripts/generate-compliance.mjs",
    "boundaries": "npm --prefix core run boundaries",
    "e2e": "NEXT_PUBLIC_QWBE_API=http://127.0.0.1:4520 npm --prefix web run build && playwright test",
    "screenshots": "node screenshots.mjs",
    "probe:lifecycle": "node probes/lifecycle.mjs",
    "probe:store": "node probes/store.mjs",
    "probe:sizecaps-baseline": "node probes/sizecaps-baseline.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@effect/eslint-plugin": "^0.3.2",
    "@playwright/test": "^1.58.2",
    "@secretlint/secretlint-rule-aws": "^13.0.4",
    "@secretlint/secretlint-rule-pattern": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "secretlint": "^13.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "_comment": "22.18 is where TypeScript type-stripping stopped needing a flag. `npm test` runs .ts files directly and `npm run api` has always done the same, so the old >=22.5.0 was already understating what this repository needs.",
    "node": ">=22.18.0"
  }
}
