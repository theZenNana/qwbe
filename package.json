{
  "name": "qwbe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Qwbe -- kernel that discovers cubes from disk. One cube = one directory; installing it touches no existing file.",
  "scripts": {
    "setup": "node core/tools/setup/bootstrap.mjs",
    "secrets": "npx --no-install secretlint \"**/*\"",
    "start": "node core/tools/dev/dev.ts",
    "api": "node core/tools/dev/dev.ts api",
    "web": "node core/tools/dev/dev.ts web",
    "test": "node --test \"core/src/**/*.test.ts\" \"core/plugins/**/*.test.ts\" \"web/**/*.test.ts\"",
    "format": "biome format --write .",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p core/tsconfig.json",
    "check": "node core/tools/check/check.ts",
    "check:strict": "node core/tools/check/check.ts --strict",
    "check:live": "node core/tools/check/check.ts --live",
    "check:bench": "node core/tools/check/check.ts --bench",
    "boundaries": "npm --prefix core run boundaries",
    "e2e": "node core/tools/dev/e2e.ts",
    "db:up": "node core/tools/db/db.ts up",
    "db:down": "node core/tools/db/db.ts down",
    "db:clean": "node core/tools/db/db.ts clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@effect/eslint-plugin": "^0.3.2",
    "@playwright/test": "^1.58.2",
    "@secretlint/secretlint-rule-aws": "^13.0.4",
    "@secretlint/secretlint-rule-pattern": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "secretlint": "^13.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "_comment": "22.18 is where TypeScript type-stripping stopped needing a flag. `npm test` runs .ts files directly and `npm run api` has always done the same, so the old >=22.5.0 was already understating what this repository needs.",
    "node": ">=22.18.0"
  }
}
