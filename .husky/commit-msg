# qwbe commit-msg. Deliberately NOT conventional commits (`feat:`, `fix:` ...). The messages in this
# repo carry a sentence of reasoning - "the branch did not have the repair from master, not the
# other way around" - and a machine-readable prefix adds nothing to that. What is enforced here is
# only what makes a log readable years later:
#
#   - ASCII, same reason as the source
#   - a subject short enough to survive `git log --oneline`
#   - a blank line before the body, because git tooling everywhere assumes it
#
# The 50/72 convention comes from the Linux kernel patch guidelines and Tim Pope's 2008 note: 72 is
# 80 minus git's 4-space indent minus padding. 72 here is a hard stop rather than the softer 50,
# because this repo's history genuinely uses long subjects and rewriting them adds nothing.

message_file=$1
subject=$(head -n 1 "$message_file")

# Merge commits and fixups are generated by git itself; their shape is not ours to police.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

fail() {
  echo "x commit message: $1" >&2
  echo "  subject was: $subject" >&2
  exit 1
}

[ -n "$subject" ] || fail "the subject line is empty"

# LC_ALL=C makes grep treat bytes rather than characters, which is what "is this ASCII" means.
if LC_ALL=C grep -qP '[^\x00-\x7F]' "$message_file"; then
  offending=$(LC_ALL=C grep -nP '[^\x00-\x7F]' "$message_file" | head -3)
  echo "x commit message contains non-ASCII characters:" >&2
  echo "$offending" | sed 's/^/    /' >&2
  echo "  Write the message in English, without diacritics." >&2
  exit 1
fi

length=${#subject}
[ "$length" -le 72 ] || fail "the subject is $length characters; the limit is 72"

case "$subject" in
  *.) fail "the subject ends with a period; drop it" ;;
esac

# A body glued to the subject makes `git log --oneline` print the whole paragraph.
second=$(sed -n '2p' "$message_file")
if [ -n "$second" ]; then
  fail "line 2 must be blank when there is a body"
fi
