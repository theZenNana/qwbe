QWBE_DATABASE_URL=postgres://postgres:qwbe@localhost:5433/qwbe
# Set to export each request's spans and metrics to the local Grafana LGTM stack
# (docker compose --profile trace up -d lgtm).
# QWBE_TRACE_URL=http://localhost:4318
# Host port of the local Grafana (the lgtm service); 3000 is often taken.
# QWBE_GRAFANA_PORT=3300
